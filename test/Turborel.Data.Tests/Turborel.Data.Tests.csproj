<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The tests, one project, run by xUnit v3 on Microsoft.Testing.Platform
    (RULES.md D12, R-TEST-7). It is an executable: `dotnet test` runs it.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>Turborel.Data.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="coverlet.MTP" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Turborel.Data/Turborel.Data.csproj" />
  </ItemGroup>

</Project>
